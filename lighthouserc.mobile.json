{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "/index.html",
        "/code/index.html",
        "/partners/index.html",
        "/docs/agentx/releases/index.html"
      ],
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "document-title": "error",
        "meta-description": "error",
        "http-status-code": "error",
        "link-text": "error",
        "crawlable-anchors": "error",
        "robots-txt": "error",
        "image-alt": "error",
        "hreflang": "error",
        "canonical": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
