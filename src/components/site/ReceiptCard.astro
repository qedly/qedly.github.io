---
/** One receipt: a real merged pull request QEDly Code opened, the commit its checks ran on, and each check's result. */
import type { Receipt } from "../../lib/receipts";
interface Props { receipt: Receipt; tilt?: number }
const { receipt, tilt = 0 } = Astro.props;
const passed = receipt.gates.length > 0 && receipt.gates.every((gate) => gate.status === "success");
const short = receipt.commit.slice(0, 7);
---
<article class="q-receipt q-mono" style={`transform: rotate(${tilt}deg)`}>
  <p class="q-receipt-top"><span>Receipt No. {receipt.number}</span>{passed && <img class="q-stamp" src="/brand/qed-stamp.svg" alt="QED" />}</p>
  <h3><a href={receipt.url}>{receipt.title}</a></h3>
  <ul>{receipt.gates.map((gate) => <li class={gate.status === "success" ? "q-ok" : "q-bad"}><a href={gate.url}>{gate.name}</a> {gate.status === "success" ? "passed" : gate.status} · {short}</li>)}</ul>
  {receipt.logsExpired && <p class="q-faint">Check log expired. The result was recorded when it ran.</p>}
  <p class="q-faint">Asked by {receipt.requester} · merged by {receipt.mergedBy}</p>
</article>
<style>
  .q-receipt { background: var(--q-paper); border: var(--q-border); padding: 22px; display: grid; gap: 10px; align-content: start; font-size: 0.8125rem; min-width: 0; }
  .q-receipt p, .q-receipt ul { margin: 0; }
  .q-receipt ul { list-style: none; padding: 0; display: grid; gap: 4px; }
  .q-receipt-top { display: flex; justify-content: space-between; align-items: center; color: var(--q-ink-muted); text-transform: uppercase; }
  h3 { margin: 0; font-family: var(--q-font-body); font-size: 1.125rem; font-weight: 600; line-height: 1.3; }
  h3 a { text-decoration: none; }
  .q-ok, .q-ok a { color: var(--q-green); }
  .q-bad, .q-bad a { color: var(--q-red); }
  .q-faint { color: var(--q-ink-muted); }
  .q-stamp { height: 20px; width: auto; max-width: none; }
  @media (prefers-reduced-motion: reduce) { .q-receipt { transform: none !important; } }
</style>
