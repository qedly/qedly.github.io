---
/** Running totals over every receipt. Counted at build time from GitHub, never typed. */
import type { Receipt } from "../../lib/receipts";
import { totals } from "../../lib/receipts";
interface Props { receipts: Receipt[] }
const sum = totals(Astro.props.receipts);
---
<dl class="q-totals q-mono">
  <div><dt>Receipts</dt><dd>{sum.receipts}</dd></div>
  <div><dt>Checks run</dt><dd>{sum.checksRun}</dd></div>
  <div><dt>All checks passed</dt><dd class="q-green">{sum.allPassed}</dd></div>
</dl>
<style>
  .q-totals { display: flex; flex-wrap: wrap; gap: 20px 44px; margin: 0; }
  .q-totals div { display: flex; flex-direction: column-reverse; }
  dt { font-size: 0.8125rem; color: var(--q-ink-muted); text-transform: uppercase; }
  dd { margin: 0; font-size: 2.75rem; font-weight: 700; line-height: 1.1; }
  .q-green { color: var(--q-green); }
</style>
