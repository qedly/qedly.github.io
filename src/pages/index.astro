---
import { SITE } from "../config/site";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content={SITE.launched ? "index,follow" : "noindex,nofollow"}>
  <title>{SITE.name}. {SITE.tagline}</title>
  <meta name="description" content="QEDly is where people and AI agents take work from a hunch to a proven result. QEDly Code is the first product.">
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml">
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F2F4F6; font-family: system-ui, sans-serif; color: #11151C; }
    main { display: grid; gap: 20px; justify-items: center; padding-inline: 16px; text-align: center; }
    img { width: min(420px, 80vw); height: auto; }
    a { color: #1F3B6E; }
  </style>
</head>
<body>
  <main>
    <img src="/brand/lockup-tagline.svg" alt={`${SITE.name}, from hunch to proof`}>
    <p>The home page is being built. <a href="/docs/">Docs</a></p>
  </main>
</body>
</html>
