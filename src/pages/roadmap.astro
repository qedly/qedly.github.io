---
import Marketing from "../layouts/Marketing.astro";
import PageIntro from "../components/site/PageIntro.astro";
import Eyebrow from "../components/brand/Eyebrow.astro";
import WaitlistForm from "../components/site/WaitlistForm.astro";
import { PRODUCTS } from "../data/products";
import { STATUS_LABEL, type Status } from "../config/site";

const groups: { status: Status; tone: "green" | "blue" | "ink"; lede: string }[] = [
  { status: "now", tone: "green", lede: "Shipping today, in your AWS account." },
  { status: "next", tone: "blue", lede: "What we are building next." },
  { status: "later", tone: "ink", lede: "Where it goes after that." },
];
---
<Marketing title="QEDly roadmap: Now, Next and Later" description="QEDly Code and Checks ship today. Workspace and Passport come next, then Outcomes and Cloud. Join the waitlist for Workspace or Cloud." path="/roadmap/">
  <PageIntro eyebrow="Roadmap">
    <Fragment slot="title">Code is the first chapter.</Fragment>
    <p>QEDly is where people and AI agents take work from a hunch to a proven result. It starts with an agent that has to prove its code. Here is what exists now, and what comes next.</p>
  </PageIntro>
  {groups.map((group) => (
    <section class:list={["q-section", "q-stack", { "q-section-white": group.status === "next" }]}>
      <Eyebrow tone={group.tone}>{STATUS_LABEL[group.status]}</Eyebrow>
      <p class="q-body">{group.lede}</p>
      <div class="cards">
        {PRODUCTS.filter((product) => product.status === group.status).map((product) => (
          <article class="q-card">
            <h2 class="name">{product.name}</h2>
            <p class="q-body">{product.job}</p>
            {product.status === "now" && product.name === "QEDly Code" && <p><a href="/code/">What QEDly Code does today</a></p>}
            {product.waitlist && <WaitlistForm tag={product.waitlist} product={product.name} />}
          </article>
        ))}
      </div>
    </section>
  ))}
</Marketing>
<style>.cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 980px; } @media (max-width: 700px) { .cards { grid-template-columns: minmax(0, 1fr); } } .name { margin: 0; font-family: var(--q-font-display); font-weight: 900; letter-spacing: -0.03em; font-size: 1.75rem; line-height: 1.1; }</style>
